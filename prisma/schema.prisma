generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/"
}

datasource db {
  provider = "postgresql"
}

enum RecipeType {
  OWNED
  EXTERNAL_FULL
  EXTERNAL_LINK
}

enum ImportStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
}

enum UserContactType {
  FEEDBACK
  BUG
  DMCA
  REPORT
  GENERAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessionVersion Int @default(0)

  // Relations
  recipes    Recipe[]
  importJobs ImportJob[] // ← add this line
  accounts   Account[]
  sessions   Session[]

  uploads      Upload[]
  userContacts UserContact[]
}

model Recipe {
  id               String       @id @default(cuid())
  ownerId          String
  type             RecipeType
  title            String       @default("")
  description      String       @default("")
  prepMins         Int?
  cookMins         Int?
  servings         Int?
  imageKey         String?      @unique
  imageExternalUrl String?
  ingredients      String[]
  steps            String[]
  tags             String[]
  note             String       @default("")
  sourceUrl        String?
  slug             String       @unique
  isPublic         Boolean      @default(false)
  status           RecipeStatus @default(PUBLISHED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([isPublic])
}

model Upload {
  id          String   @id @default(uuid()) // "uploadId" returned to client
  userId      String
  key         String   @unique // e.g. user/<userId>/<uuid>.<ext>
  size        Int // bytes (after client compression)
  contentType String // image/jpeg | image/png | image/webp
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ImportJob {
  id         String       @id @default(cuid())
  userId     String
  sourceUrl  String
  status     ImportStatus @default(PENDING)
  rawHtml    String?
  parsedJson Json?
  errorMsg   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([sourceUrl])
}

model UserContact {
  id          String          @id @default(cuid())
  userId      String?
  contactType UserContactType @default(GENERAL)
  metaData    Json?
  data        Json?
  createdAt   DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactType])
  @@index([userId])
}

/**
 * * Auth.js adapter tables **
 */
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
